# ============================================
# FORCE HTTPS + WWW (SEO - Duplicate Content Fix)
# ============================================
<IfModule mod_rewrite.c>
RewriteEngine On

# Step 1: Redirect HTTP to HTTPS first
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Step 2: Redirect non-www to www
RewriteCond %{HTTP_HOST} ^jusjumpin\.com$ [NC]
RewriteRule ^(.*)$ https://www.jusjumpin.com/$1 [R=301,L]
</IfModule>

# ============================================
# WORDPRESS CORE (Do not modify)
# ============================================
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# ============================================
# CUSTOM REWRITE RULES FOR BLOG POSTS
# ============================================
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^blog/([^/]+)/?$ index.php?name=$1&post_type=post [QSA,L]
RewriteRule ^blog/page/([0-9]+)/?$ index.php?pagename=blog&paged=$1 [QSA,L]
RewriteRule ^blog/feed/?$ index.php?feed=feed [QSA,L]
RewriteRule ^blog/feed/(feed|rdf|rss|rss2|atom)/?$ index.php?feed=$1 [QSA,L]
RewriteRule ^blog/(feed|rdf|rss|rss2|atom)/?$ index.php?feed=$1 [QSA,L]
</IfModule>

